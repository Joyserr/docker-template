# Java 17 Development Environment
ARG JAVA_VERSION=17
FROM openjdk:${JAVA_VERSION}-slim

ARG USE_CN_MIRROR=true
ENV DEBIAN_FRONTEND=noninteractive

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# Configure apt mirror (optional)
RUN if [ "$USE_CN_MIRROR" = "true" ]; then \
        sed -i 's|http://deb.debian.org/debian|https://mirrors.ustc.edu.cn/debian|g' /etc/apt/sources.list && \
        sed -i 's|http://security.debian.org|https://mirrors.ustc.edu.cn/debian-security|g' /etc/apt/sources.list; \
    fi

# Install system packages
RUN apt-get update && apt-get install -y \
    vim wget htop tmux \
    build-essential cmake git curl \
    bash-completion sudo unzip \
    tree less jq \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment variables
ENV JAVA_HOME=/usr/local/openjdk-${JAVA_VERSION}
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Maven
RUN wget -q -O /tmp/maven.tar.gz https://dlcdn.apache.org/maven/maven-3/3.9.4/binaries/apache-maven-3.9.4-bin.tar.gz && \
    tar -xzf /tmp/maven.tar.gz -C /opt/ && \
    rm /tmp/maven.tar.gz

ENV MAVEN_HOME=/opt/apache-maven-3.9.4
ENV PATH=$MAVEN_HOME/bin:$PATH

# Install Gradle
RUN wget -q -O /tmp/gradle.zip https://services.gradle.org/distributions/gradle-8.4-bin.zip && \
    unzip -q /tmp/gradle.zip -d /opt/ && \
    rm /tmp/gradle.zip

ENV GRADLE_HOME=/opt/gradle-8.4
ENV PATH=$GRADLE_HOME/bin:$PATH

# Create user (match host UID/GID to avoid permission issues)
ARG USER_NAME=sysadmin
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd -g ${USER_GID} ${USER_NAME} || true && \
    useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash ${USER_NAME} && \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER ${USER_NAME}
WORKDIR /home/${USER_NAME}

RUN mkdir -p ~/workspace
WORKDIR /home/${USER_NAME}/workspace

# Copy custom bashrc configuration
COPY --chown=${USER_NAME}:${USER_NAME} docker/config/bashrc /home/${USER_NAME}/.bashrc_docker
RUN echo "if [ -f ~/.bashrc_docker ]; then source ~/.bashrc_docker; fi" >> ~/.bashrc

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep -x "bash" > /dev/null || exit 1

CMD ["/bin/bash"]
