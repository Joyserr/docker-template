# Docker dev environment config (generated by make init)

# User (match host to avoid permission issues)
USER_NAME=duboping
USER_UID=1000
USER_GID=1000

# Image
IMAGE_NAME=dev
IMAGE_TAG=latest
CONTAINER_NAME=dev

# Workspace
WORKSPACE_DIR=/home/duboping/project/kudan-devkit-support/code/docker-template
CONTAINER_WORKSPACE=workspace
