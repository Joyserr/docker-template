# Docker Container Shell Configuration
# This file is replaced by `make use T=<template>` with the corresponding template bashrc.
# Below is the universal base configuration, suitable for all templates.

# Exit immediately if not running interactively
case $- in
    *i*) ;;
      *) return;;
esac

# ---------- History ----------
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# ---------- General ----------
shopt -s checkwinsize

if [ -f /etc/bash_completion ] && ! shopt -oq posix; then
    . /etc/bash_completion
fi

# ---------- Colors ----------
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi

# ---------- Aliases ----------
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# ---------- Environment ----------
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=vim

# ---------- Prompt ----------
PS1='\[\033[01;32m\]\u@docker\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

echo "Development container ready — $(whoami)@$(hostname)"
