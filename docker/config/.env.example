# Docker development environment configuration
# Run 'make init' to auto-generate this file, or copy it to .env and edit manually

# User (match host to avoid permission issues)
USER_NAME=user
USER_UID=1000
USER_GID=1000

# Image
IMAGE_NAME=dev
IMAGE_TAG=latest
CONTAINER_NAME=dev

# Workspace
WORKSPACE_DIR=/path/to/your/project
CONTAINER_WORKSPACE=workspace
